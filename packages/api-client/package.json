{
  "name": "@eudora/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "corepack pnpm generate --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/generated/schema.ts",
    "check": "node scripts/check-generated.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.15.0"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  }
}
